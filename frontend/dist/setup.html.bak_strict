<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <title>Voice Bridge · 设备设置</title>
  <style>
    :root {
      /* ── 配色方案 2026-04-01 ── */
      /* 主色 */
      --blue: #4361ee;
      --blue-light: #eff6ff;
      --blue-dark: #3a56d4;
      /* 辅助色（小面积） */
      --purple: #7209b7;
      /* 成功 */
      --success-bg: #e8f4f8;
      --success-text: #2a9d8f;
      /* 警告 */
      --orange: #e07b39;
      --orange-light: #fff7ed;
      /* 失败 */
      --error-bg: #fff5f5;
      --error-text: #e53e3e;
      /* 中性灰 */
      --gray: #718096;
      --gray-mid: #4a5568;
      --gray-light: #e2e8f0;
      /* 边框 */
      --border: #e2e8f0;
      /* 背景 */
      --bg: #f8f9fa;
      /* 文字层级 */
      --text: #2d3748;
      --text-body: #4a5568;
      --text-hint: #718096;
      /* 阴影 */
      --card-shadow: 0 1px 3px rgba(0,0,0,.05);
      --card-shadow-hover: 0 2px 6px rgba(0,0,0,.08);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 20px 16px 80px;
      line-height: 1.5;
    }

    /* ── 顶部 Logo ── */
    .logo { text-align: center; padding: 12px 0 20px; }
    .logo h1 { font-size: 22px; font-weight: 800; color: var(--blue); }
    .logo p { font-size: 13px; color: var(--text-hint); margin-top: 4px; }

    /* ── 顶部流程导航 ── */
    .top-nav {
      background: #fff;
      border-radius: 12px;
      box-shadow: var(--card-shadow);
      border: 1px solid var(--border);
      max-width: 480px;
      margin: 0 auto 14px;
      padding: 10px 14px;
    }
    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 2px;
      flex-wrap: wrap;
    }
    .nav-item {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-hint);
      cursor: pointer;
      padding: 5px 8px;
      border-radius: 8px;
      text-decoration: none;
      transition: background .15s, color .15s;
      user-select: none;
    }
    .nav-item:hover { background: var(--gray-light); color: var(--text-body); }
    .nav-item.active { color: var(--blue); }
    .nav-dot {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: var(--gray-light);
      color: var(--text-hint);
      font-size: 11px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background .3s, color .3s;
    }
    .nav-dot.done {
      background: var(--blue);
      color: #fff;
    }
    .nav-dot.active {
      background: var(--blue);
      color: #fff;
    }
    .nav-arrow { color: var(--gray-light); font-size: 18px; user-select: none; }

    /* ── 连接信息卡片 ── */
    .card {
      background: #fff;
      border-radius: 12px;
      padding: 16px 16px;
      margin-bottom: 14px;
      box-shadow: var(--card-shadow);
      border: 1px solid var(--border);
      max-width: 480px;
      margin-left: auto;
      margin-right: auto;
    }
    .card-title {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-hint);
      letter-spacing: .04em;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    /* ── 可折叠卡片 ── */
    .vb-card {
      background: #fff;
      border-radius: 12px;
      box-shadow: var(--card-shadow);
      border: 1px solid var(--border);
      max-width: 480px;
      margin: 0 auto 14px;
      overflow: hidden;
      transition: box-shadow .2s;
    }
    .vb-card:hover { box-shadow: var(--card-shadow-hover); }
    .vb-card-header {
      display: flex;
      justify-content: flex-start;
      align-items: center;
      gap: 10px;
      padding: 15px 18px;
      width: 100%;
      cursor: pointer;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
      background: transparent;
    }
    .vb-card-header:active { background: rgba(0,0,0,.03); }
    .vb-card-num {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: var(--blue);
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background .3s;
    }
    /* 完成后：保持蓝色圆圈，显示数字 */
    .vb-card-title {
      flex: 1;
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
    }
    .vb-card-chevron {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      transition: transform .2s ease;
      color: var(--text-hint);
    }
    .vb-card-chevron.expanded { transform: rotate(0deg); }
    .vb-card-chevron.collapsed { transform: rotate(-90deg); }
    .vb-card-body {
      display: block;
      padding: 0 18px 18px;
    }
    .vb-card-body.collapsed {
      display: none;
    }

    /* ── 信息行 ── */
    .info-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 0;
      border-bottom: 1px solid var(--border);
      font-size: 14px;
    }
    .info-row:last-child { border-bottom: none; }
    .info-row .lbl { color: var(--text-hint); flex-shrink: 0; font-size: 13px; }
    .info-row .val {
      font-weight: 600;
      font-family: "SF Mono", "Fira Mono", monospace;
      font-size: 12px;
      text-align: right;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .addr-link {
      color: var(--blue);
      font-weight: 600;
      font-family: "SF Mono", "Fira Mono", monospace;
      font-size: 12px;
      text-decoration: none;
      display: inline-block;
      padding: 2px 6px;
      border-radius: 6px;
      background: var(--blue-light);
      transition: background .15s;
    }
    .addr-link:hover { background: #dbeafe; }
    /* 复制按钮 */
    .copy-btn {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 14px;
      padding: 2px 4px;
      border-radius: 4px;
      color: var(--text-hint);
      transition: color .15s, background .15s;
      position: relative;
    }
    .copy-btn:hover { color: var(--blue); background: var(--blue-light); }
    .copy-btn .copy-tip {
      display: none;
      position: absolute;
      bottom: calc(100% + 4px);
      right: 0;
      background: #333;
      color: #fff;
      font-size: 11px;
      padding: 3px 7px;
      border-radius: 4px;
      white-space: nowrap;
      z-index: 10;
    }
    .copy-btn:hover .copy-tip { display: block; }

    /* ── 步骤进度条（保留但不显示） ── */
    .step-track { display: none; }

    /* ── 提示框 ── */
    .alert {
      padding: 11px 13px;
      border-radius: 8px;
      font-size: 13px;
      line-height: 1.6;
      margin-bottom: 12px;
    }
    .alert-blue   { background: var(--blue-light); color: var(--blue); }
    .alert-orange { background: var(--orange-light); color: var(--orange); }
    .alert-hint   { background: var(--gray-light); color: var(--text-hint); }

    /* ── 按钮 ── */
    .btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      width: 100%;
      padding: 12px 20px;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 600;
      text-align: center;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: background .2s, transform .1s, opacity .15s;
      margin-top: 10px;
      -webkit-appearance: none;
    }
    .btn:active:not(:disabled) { transform: scale(.97); }
    /* 主按钮：科技蓝 */
    .btn-primary   { background: var(--blue); color: #fff; }
    .btn-primary:hover:not(:disabled) { background: var(--blue-dark); }
    /* 次要按钮：浅蓝 */
    .btn-secondary { background: var(--blue-light); color: var(--blue); }
    .btn-secondary:hover:not(:disabled) { background: #dbeafe; }
    /* 灰色按钮 */
    .btn-gray      { background: var(--gray-light); color: var(--gray-mid); }
    .btn-gray:hover:not(:disabled) { background: #d1d5db; color: var(--text); }
    /* 禁用：严格样式 */
    .btn:disabled {
      background: var(--gray-light);
      color: var(--text-hint);
      cursor: not-allowed;
      opacity: 1;
    }
    .btn-small { padding: 9px 16px; font-size: 13px; }

    /* ── 安装步骤 ── */
    .install-steps { display: flex; flex-direction: column; gap: 10px; margin: 12px 0; }
    .i-step { display: flex; gap: 10px; align-items: flex-start; }
    .i-num {
      width: 22px; height: 22px;
      background: var(--blue); color: #fff;
      border-radius: 50%;
      font-size: 12px; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; margin-top: 1px;
    }
    .i-body { font-size: 13px; line-height: 1.6; color: var(--text-body); }
    .i-body code { background: var(--gray-light); padding: 1px 5px; border-radius: 4px; font-size: 12px; }

    /* ── 输入框 ── */
    .input-group { margin: 12px 0 6px; }
    .input-label-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 6px;
    }
    .input-label-row .char-count {
      font-size: 12px;
      color: var(--text-hint);
    }
    input[type="text"] {
      width: 100%;
      padding: 12px 14px;
      border: 1.5px solid var(--border);
      border-radius: 8px;
      font-size: 15px;
      outline: none;
      color: var(--text);
      background: #fff;
      -webkit-appearance: none;
      transition: border-color .2s, box-shadow .2s;
      line-height: 1.5;
    }
    input:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(67,97,238,.1);
    }
    input:disabled {
      background: var(--gray-light);
      color: var(--text-hint);
      cursor: not-allowed;
    }
    .input-hint { font-size: 12px; color: var(--text-hint); margin-top: 5px; }

    /* ── 成功态（命名后显示） ── */
    .device-named { text-align: center; padding: 8px 0 4px; }
    .device-named .name-big { font-size: 22px; font-weight: 800; color: var(--text); margin-bottom: 4px; }
    .device-named .name-sub { font-size: 13px; color: var(--text-hint); }

    /* ── 隐藏 ── */
    .hidden { display: none !important; }

    /* ── 加载中 ── */
    .loading {
      text-align: center;
      padding: 60px 20px;
      color: var(--text-hint);
      font-size: 15px;
    }
    .loading .spin {
      display: inline-block;
      animation: spin 1s linear infinite;
      font-size: 32px;
      margin-bottom: 14px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .loading .tip { font-size: 12px; margin-top: 8px; }

    /* ── Toast ── */
    .toast {
      position: fixed; bottom: 40px; left: 50%;
      transform: translateX(-50%);
      background: #1a1a2e;
      color: #fff;
      padding: 10px 22px;
      border-radius: 99px;
      font-size: 14px;
      z-index: 9999;
      white-space: nowrap;
      transition: opacity .4s;
      box-shadow: 0 4px 12px rgba(0,0,0,.15);
    }

    /* ── 证书状态提示框（三态：新配色） ── */
    .cert-tip {
      display: flex;
      align-items: center;
      gap: 8px;
      border-radius: 8px;
      padding: 12px 14px;
      font-size: 14px;
      font-weight: 600;
      margin-top: 12px;
      transition: all .3s;
    }
    .cert-tip-icon {
      font-size: 15px;
      font-weight: 700;
      flex-shrink: 0;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    /* 成功：浅蓝背景 + 青蓝文字 */
    .cert-tip-success {
      background: var(--success-bg);
      color: var(--success-text);
    }
    .cert-tip-success .cert-tip-icon {
      background: rgba(42,157,143,.15);
    }
    /* 失败：浅红背景 + 暗红文字 */
    .cert-tip-error {
      background: var(--error-bg);
      color: var(--error-text);
    }
    .cert-tip-error .cert-tip-icon {
      background: rgba(229,62,62,.12);
    }
    /* 加载中：灰底 */
    .cert-tip-loading {
      background: var(--gray-light);
      color: var(--text-hint);
    }
    .cert-tip-loading .cert-tip-icon {
      animation: certSpin .8s linear infinite;
    }
    @keyframes certSpin { to { transform: rotate(360deg); } }

    /* ── 手动检测按钮 ── */
    .check-btn {
      width: 100%;
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      background: var(--blue-light);
      color: var(--blue);
      transition: background .2s, opacity .2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-top: 10px;
    }
    .check-btn:hover:not(:disabled) { background: #dbeafe; }
    .check-btn:disabled {
      background: var(--gray-light);
      color: var(--text-hint);
      opacity: 1;
      cursor: not-allowed;
    }

    /* ── 证书徽章 ── */
    .cert-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 10px;
      border-radius: 99px;
      font-size: 12px;
      font-weight: 600;
      margin-bottom: 10px;
    }
    .cert-badge.unknown   { background: var(--gray-light); color: var(--text-hint); }
    .cert-badge.untrusted { background: var(--error-bg); color: var(--error-text); }
    .cert-badge.trusted    { background: var(--success-bg); color: var(--success-text); }
  </style>
</head>
<body>

<div class="logo">
  <h1>🌉 Voice Bridge</h1>
  <p>设备初始化向导</p>
</div>

<!-- 顶部流程导航 -->
<nav class="top-nav hidden" id="topNav">
  <div class="nav-inner">
    <a class="nav-item" id="navItem1" onclick="navToCard('nameCard')">
      <span class="nav-dot" id="navDot1">1</span>
      <span>命名设备</span>
    </a>
    <div class="nav-arrow">›</div>
    <a class="nav-item" id="navItem2" onclick="navToCard('certCard')">
      <span class="nav-dot" id="navDot2">2</span>
      <span>安装证书</span>
    </a>
    <div class="nav-arrow">›</div>
    <a class="nav-item" id="navItem3" onclick="navToCard('enterCard')">
      <span class="nav-dot" id="navDot3">3</span>
      <span>开始使用</span>
    </a>
  </div>
</nav>

<!-- 加载中 -->
<div id="loading" class="loading">
  <div class="spin">⚙️</div>
  <div id="loadingText">正在识别设备…</div>
  <div class="tip">请稍候</div>
</div>

<!-- 主内容 -->
<div id="main" class="hidden">

  <!-- 连接信息 -->
  <div class="card">
    <div class="card-title">📡 服务地址</div>
    <div class="info-row">
      <span class="lbl">HTTP 局域网</span>
      <span class="val" id="httpAddr">…</span>
    </div>
    <div class="info-row">
      <span class="lbl">HTTPS 局域网</span>
      <span class="val" id="httpsAddr">…</span>
    </div>
  </div>

  <!-- 第一步：给设备命名 -->
  <div class="vb-card" id="nameCard">
    <div class="vb-card-header" onclick="toggleCard('nameCard')">
      <div class="vb-card-num" id="nameCardNum">1</div>
      <div class="vb-card-title">✏️ 给设备命名</div>
      <svg class="vb-card-chevron expanded" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"/>
      </svg>
    </div>
    <div class="vb-card-body" id="nameBody"></div>
  </div>

  <!-- 第二步：安装证书 -->
  <div class="vb-card" id="certCard">
    <div class="vb-card-header" onclick="toggleCard('certCard')">
      <div class="vb-card-num" id="certCardNum">2</div>
      <div class="vb-card-title">🔒 安装证书</div>
      <svg class="vb-card-chevron expanded" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"/>
      </svg>
    </div>
    <div class="vb-card-body" id="certBody"></div>
  </div>

  <!-- 第三步：开始使用 -->
  <div class="vb-card" id="enterCard">
    <div class="vb-card-header" onclick="toggleCard('enterCard')">
      <div class="vb-card-num" id="enterCardNum">3</div>
      <div class="vb-card-title">🚀 开始使用</div>
      <svg class="vb-card-chevron expanded" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"/>
      </svg>
    </div>
    <div class="vb-card-body" id="enterBody"></div>
  </div>

</div>

<script>
(function () {
  'use strict';

  // ============================================================
  //  常量
  // ============================================================
  const HTTP_PORT  = 7266
  const HTTPS_PORT = 7267
  const IS_HTTPS   = location.protocol === 'https:'
  const HOST       = location.hostname
  const PORT       = location.port
  const API_BASE   = `${location.protocol}//${HOST}:${PORT}`

  // localStorage keys
  const DEVICE_ID_KEY      = 'vb_device_id'
  const DEVICE_NAME_KEY    = 'vb_device_name'
  const DEVICE_FP_KEY      = 'vb_device_fingerprint'
  const ONBOARDING_KEY     = 'vb_onboarding_done'
  const CERT_TRUSTED_KEY   = 'vb_cert_trusted'
  const CERT_DOWNLOADED_KEY= 'vb_cert_downloaded'
  const CARD_STATES_KEY    = 'vb_card_states'   // 新增：卡片折叠状态持久化
  const MAX_NAME_LEN       = 32

  // ============================================================
  //  状态
  // ============================================================
  let serverIp   = HOST
  let deviceId   = ''
  let deviceName = ''
  let deviceFp   = ''
  let currentStep = 1
  let httpsHealthy = false
  let isChecking   = false

  // 卡片折叠状态（从 localStorage 恢复）
  let cardStates = loadCardStates()

  // ============================================================
  //  工具函数
  // ============================================================
  const $ = id => document.getElementById(id)
  const esc = s => String(s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
    .replace(/>/g, '&gt;').replace(/"/g, '&quot;')

  const isIOS     = () => /iphone|ipad|ipod/i.test(navigator.userAgent)
  const isAndroid = () => /android/i.test(navigator.userAgent)
  const isMobile  = () => isIOS() || isAndroid()

  function toast(msg, duration) {
    let t = document.querySelector('.toast')
    if (t) t.remove()
    t = document.createElement('div')
    t.className = 'toast'
    t.textContent = msg
    document.body.appendChild(t)
    setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 400) }, duration || 2200)
  }

  function showLoading(text) {
    const el = $('loadingText')
    if (el) el.textContent = text || '正在初始化…'
  }

  // ============================================================
  //  一键复制功能
  // ============================================================
  window.copyAddress = function(url, el) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url).then(() => {
        toast('已复制到剪贴板')
      }).catch(() => {
        fallbackCopy(url)
      })
    } else {
      fallbackCopy(url)
    }
  }

  function fallbackCopy(text) {
    const ta = document.createElement('textarea')
    ta.value = text
    ta.style.cssText = 'position:fixed;opacity:0;top:0;left:0'
    document.body.appendChild(ta)
    ta.select()
    try { document.execCommand('copy') } catch(e) {}
    document.body.removeChild(ta)
    toast('已复制到剪贴板')
  }

  // ============================================================
  //  卡片折叠/展开逻辑（持久化到 localStorage）
  // ============================================================
  function loadCardStates() {
    try {
      const saved = localStorage.getItem(CARD_STATES_KEY)
      if (saved) return JSON.parse(saved)
    } catch(e) {}
    return { nameCard: true, certCard: true, enterCard: true }
  }

  function saveCardStates() {
    try {
      localStorage.setItem(CARD_STATES_KEY, JSON.stringify(cardStates))
    } catch(e) {}
  }

  function toggleCard(cardId) {
    cardStates[cardId] = !cardStates[cardId]
    updateCardUI(cardId)
    saveCardStates()
  }

  function expandCard(cardId) {
    cardStates[cardId] = true
    updateCardUI(cardId)
    saveCardStates()
  }

  function collapseCard(cardId) {
    cardStates[cardId] = false
    updateCardUI(cardId)
    saveCardStates()
  }

  function updateCardUI(cardId) {
    const body = document.querySelector(`#${cardId} .vb-card-body`)
    const chev = document.querySelector(`#${cardId} .vb-card-chevron`)
    if (!body || !chev) {
      console.warn('updateCardUI 找不到元素:', cardId)
      return
    }

    const expanded = cardStates[cardId]

    // 简单的显示/隐藏切换
    body.classList.toggle('collapsed', !expanded)

    // 箭头旋转
    chev.classList.toggle('expanded', expanded)
    chev.classList.toggle('collapsed', !expanded)
  }

  window.navToCard = function(cardId) {
    const el = document.getElementById(cardId)
    if (!el) return
    expandCard(cardId)
    el.scrollIntoView({ behavior: 'smooth', block: 'start' })
  }

  // ============================================================
  //  UUID 生成
  // ============================================================
  function generateUUID() {
    if (crypto.randomUUID) return crypto.randomUUID()
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
      const r = Math.random() * 16 | 0
      return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16)
    })
  }

  // ============================================================
  //  设备指纹生成（纯原生）
  // ============================================================
  async function generateFingerprint() {
    const cached = localStorage.getItem(DEVICE_FP_KEY)
    if (cached) return cached

    try {
      const canvas = document.createElement('canvas')
      const ctx = canvas.getContext('2d')
      canvas.width = 200; canvas.height = 50
      ctx.textBaseline = 'top'
      ctx.font = "14px 'Arial'"
      ctx.fillStyle = '#f60'
      ctx.fillRect(125, 1, 62, 20)
      ctx.fillStyle = '#069'
      ctx.fillText('VoiceBridge 🌉', 2, 15)
      ctx.fillStyle = 'rgba(102,204,0,0.7)'
      ctx.fillText('Device FP', 4, 17)
      const canvasData = canvas.toDataURL()

      const fpData = [
        canvasData,
        navigator.userAgent,
        screen.width + 'x' + screen.height,
        screen.colorDepth,
        navigator.language,
        new Date().getTimezoneOffset(),
        navigator.hardwareConcurrency || '',
        navigator.platform || ''
      ].join('|')

      const msgBuffer = new TextEncoder().encode(fpData)
      const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer)
      const hashHex = Array.from(new Uint8Array(hashBuffer))
        .map(b => b.toString(16).padStart(2, '0')).join('')

      localStorage.setItem(DEVICE_FP_KEY, hashHex)
      return hashHex
    } catch (e) {
      const fallback = generateUUID().replace(/-/g, '')
      localStorage.setItem(DEVICE_FP_KEY, fallback)
      return fallback
    }
  }

  // ============================================================
  //  设备 ID 管理
  // ============================================================
  function getOrCreateDeviceId() {
    let id = localStorage.getItem(DEVICE_ID_KEY)
    if (!id) {
      id = generateUUID()
      localStorage.setItem(DEVICE_ID_KEY, id)
    }
    return id
  }

  function getDeviceName() {
    return localStorage.getItem(DEVICE_NAME_KEY) || ''
  }

  function saveDeviceName(name) {
    localStorage.setItem(DEVICE_NAME_KEY, name)
  }

  function markOnboardingDone() {
    localStorage.setItem(ONBOARDING_KEY, '1')
  }

  function markCertTrusted() {
    localStorage.setItem(CERT_TRUSTED_KEY, '1')
  }

  function isCertTrustedLocal() {
    return localStorage.getItem(CERT_TRUSTED_KEY) === '1'
  }

  function markCertDownloaded() {
    localStorage.setItem(CERT_DOWNLOADED_KEY, '1')
  }

  // ============================================================
  //  HTTPS 可访问性检测
  // ============================================================
  async function httpsHealthCheck() {
    if (isChecking) return
    isChecking = true
    updateCertStatusBox()

    try {
      if (location.protocol === 'https:') {
        // 前端优先：已经是 HTTPS 协议，说明用户已点了"继续访问"
        httpsHealthy = true
      } else {
        const ctrl = new AbortController()
        const t = setTimeout(() => ctrl.abort(), 3000)
        const data = await fetchJSON(`${API_BASE}/api/check-https`, { signal: ctrl.signal })
        clearTimeout(t)
        httpsHealthy = !!(data && data.accessible)
      }
    } catch (e) {
      httpsHealthy = false
    } finally {
      isChecking = false
    }
    updateCertStatusBox()
    renderSteps()
    renderEnter()
  }

  // ============================================================
  //  心跳上报
  // ============================================================
  let heartbeatTimer = null

  function startHeartbeat() {
    if (heartbeatTimer) clearInterval(heartbeatTimer)
    const sendBeat = () => {
      if (!deviceId) return
      fetch(`${API_BASE}/api/admin/device/${encodeURIComponent(deviceId)}/heartbeat`, {
        method: 'POST',
        keepalive: true
      }).catch(() => {})
    }
    sendBeat()
    heartbeatTimer = setInterval(sendBeat, 10000)
  }

  // ============================================================
  //  生成默认设备名
  // ============================================================
  function makeDefaultDeviceName() {
    const prefix = isMobile() ? '手机' : '电脑'
    return `${prefix}-${HOST}`
  }

  // ============================================================
  //  证书检测提示框（三态：新配色）
  // ============================================================
  function updateCertStatusBox() {
    const box = document.getElementById('certStatusBox')
    if (!box) return

    if (isChecking) {
      box.className = 'cert-tip cert-tip-loading'
      box.innerHTML = `<span class="cert-tip-icon">⏳</span> 正在检测 HTTPS 访问…`
      box.style.display = 'flex'
      return
    }

    if (httpsHealthy) {
      box.className = 'cert-tip cert-tip-success'
      box.innerHTML = `<span class="cert-tip-icon">✓</span> 证书安装成功，可以访问 HTTPS`
      markCertTrusted()
      box.style.display = 'flex'
    } else {
      box.className = 'cert-tip cert-tip-error'
      box.innerHTML = `<span class="cert-tip-icon">!</span> 不能访问 HTTPS 模式，请安装证书`
      box.style.display = 'flex'
    }
  }

  // ============================================================
  //  API 调用（带超时）
  // ============================================================
  async function fetchJSON(url, options = {}) {
    const controller = new AbortController()
    const timeout = setTimeout(() => controller.abort(), options.timeout || 3000)
    try {
      const res = await fetch(url, { ...options, signal: controller.signal })
      clearTimeout(timeout)
      const ct = res.headers.get('content-type') || ''
      if (ct.includes('application/json')) return res.json()
      return null
    } catch (e) {
      clearTimeout(timeout)
      return null
    }
  }

  async function postJSON(url, body) {
    return fetchJSON(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
      timeout: 3000
    })
  }

  // ============================================================
  //  初始化
  // ============================================================
  async function init() {
    if (IS_HTTPS) {
      const existingName = getDeviceName()
      if (existingName) {
        showLoading('已完成设置，正在跳转…')
        setTimeout(() => {
          window.location.replace(`https://${HOST}:${HTTPS_PORT}`)
        }, 400)
        return
      }
    }

    showLoading('正在生成设备标识…')

    deviceFp   = await generateFingerprint()
    deviceId   = getOrCreateDeviceId()
    deviceName = getDeviceName()

    showLoading('正在连接服务器…')

    const serverInfo = await fetchJSON(`${API_BASE}/api/setup/info`).catch(() => null)
    if (serverInfo && serverInfo.server_ip) {
      serverIp = serverInfo.server_ip
    }

    showLoading('正在自动识别设备…')

    if (!deviceName && deviceFp) {
      const matchResult = await postJSON(`${API_BASE}/api/device/auto-match`, {
        device_fingerprint: deviceFp,
        current_ip: HOST
      }).catch(() => null)

      if (matchResult && matchResult.ok && matchResult.is_found) {
        deviceId   = matchResult.device_id
        deviceName = matchResult.device_name || ''
        localStorage.setItem(DEVICE_ID_KEY, deviceId)
        if (deviceName) saveDeviceName(deviceName)

        if (IS_HTTPS && deviceName) {
          showLoading('已识别设备，正在跳转…')
          setTimeout(() => {
            window.location.replace(`https://${HOST}:${HTTPS_PORT}`)
          }, 400)
          return
        }
      }
    }

    // 恢复卡片折叠状态
    cardStates = loadCardStates()

    // 显示页面
    $('loading').classList.add('hidden')
    $('main').classList.remove('hidden')
    $('topNav').classList.remove('hidden')

    renderAll()

    // 初始化所有卡片的 UI 状态
    ;['nameCard', 'certCard', 'enterCard'].forEach(updateCardUI)

    if (deviceName && deviceId) startHeartbeat()
    if (deviceName) collapseCard('nameCard')
  }

  // ============================================================
  //  渲染
  // ============================================================
  function renderAll() {
    renderAddress()
    renderSteps()
    renderName()
    renderCert()
    renderEnter()
  }

  function renderAddress() {
    const httpUrl  = `http://${serverIp}:${HTTP_PORT}`
    const httpsUrl = `https://${serverIp}:${HTTPS_PORT}`

    const httpEl  = $('httpAddr')
    const httpsEl = $('httpsAddr')

    // 带复制按钮的地址
    httpEl.innerHTML = `
      <a class="addr-link" href="${httpUrl}" target="_blank" rel="noopener">${httpUrl}</a>
      <button class="copy-btn" onclick="copyAddress('${httpUrl}', this)" title="复制">
        📋<span class="copy-tip">点击复制</span>
      </button>`

    httpsEl.innerHTML = `
      <a class="addr-link" href="${httpsUrl}" target="_blank" rel="noopener">${httpsUrl}</a>
      <button class="copy-btn" onclick="copyAddress('${httpsUrl}', this)" title="复制">
        📋<span class="copy-tip">点击复制</span>
      </button>`
  }

  function renderSteps() {
    if (!deviceName) {
      currentStep = 1
    } else if (!httpsHealthy) {
      currentStep = 2
    } else {
      currentStep = 3
    }

    // 顶部导航
    const navDots = [
      { dot: $('navDot1'), item: $('navItem1') },
      { dot: $('navDot2'), item: $('navItem2') },
      { dot: $('navDot3'), item: $('navItem3') }
    ]

    navDots.forEach((n, i) => {
      if (!n.dot || !n.item) return
      const step = i + 1
      n.dot.className = 'nav-dot'
      n.item.classList.remove('active')

      if (step < currentStep) {
        n.dot.classList.add('done')
        n.dot.textContent = '✓'
      } else if (step === currentStep) {
        n.dot.classList.add('active')
        n.dot.textContent = step
        n.item.classList.add('active')
      } else {
        n.dot.textContent = step
      }
    })

    // 卡片数字圆圈
    updateCardNum('nameCard', 1)
    updateCardNum('certCard', 2)
    updateCardNum('enterCard', 3)
  }

  function updateCardNum(cardId, num) {
    const numEl = document.querySelector(`#${cardId} .vb-card-num`)
    if (!numEl) return
    // 始终显示数字，不再用对勾替换
    numEl.classList.remove('done')
    numEl.textContent = num
  }

  // ── 渲染：设备命名 ──
  function renderName() {
    const el = $('nameBody')
    const remaining = MAX_NAME_LEN

    if (deviceName) {
      el.innerHTML = `
        <div class="device-named">
          <div class="name-big">🏷️ ${esc(deviceName)}</div>
          <div class="name-sub">当前设备名称</div>
        </div>
        <div class="input-group">
          <input type="text" id="nameInput" placeholder="修改名称…" maxlength="${MAX_NAME_LEN}" value="${esc(deviceName)}"
            oninput="onNameInput(this)">
          <p class="input-hint">最多 ${MAX_NAME_LEN} 个字符，支持中文、英文、emoji</p>
        </div>
        <button class="btn btn-secondary btn-small" id="saveBtnEl" onclick="saveName()">💾 保存修改</button>`
    } else {
      const defaultName = makeDefaultDeviceName()
      el.innerHTML = `
        <div class="alert alert-blue">给你的设备起个名字，方便识别（仅需设置一次）。</div>
        <div class="input-group">
          <div class="input-label-row">
            <span class="input-hint" style="margin:0">设备名称</span>
            <span class="char-count" id="charCount">还可输入 ${remaining} 个字符</span>
          </div>
          <input type="text" id="nameInput" placeholder="例如：小明的手机、iPad Pro…" maxlength="${MAX_NAME_LEN}"
            value="${esc(defaultName)}" oninput="onNameInput(this)">
        </div>
        <button class="btn btn-primary" id="saveBtnEl" onclick="saveName()">✅ 确认命名</button>`
      setTimeout(() => {
        const inp = document.getElementById('nameInput')
        if (inp) { inp.focus(); inp.select() }
      }, 100)
    }
  }

  // 输入框 oninput：更新字符计数 + 按钮状态
  window.onNameInput = function(input) {
    const countEl = document.getElementById('charCount')
    const btn = document.getElementById('saveBtnEl')
    if (!input) return
    const len = input.value.length
    const remaining = MAX_NAME_LEN - len
    if (countEl) countEl.textContent = `还可输入 ${remaining} 个字符`
    if (btn) {
      const hasContent = input.value.trim().length > 0
      btn.disabled = !hasContent
    }
  }

  // ── 渲染：安装证书 ──
  function renderCert() {
    const el = $('certBody')
    const certUrl = `http://${serverIp}:${HTTP_PORT}/api/cert/download`
    const trustedLocally = isCertTrustedLocal()

    // HTTPS + 已信任：直接显示成功态
    if (IS_HTTPS && trustedLocally) {
      el.innerHTML = `
        <div class="cert-tip cert-tip-success" style="margin-top:0">
          <span class="cert-tip-icon">✓</span> 证书已信任，HTTPS 安全连接正常
        </div>`
      return
    }

    let platformNote = ''

    if (isIOS()) {
      platformNote = `
        <div class="i-step"><div class="i-num">2</div>
          <div class="i-body">在 <strong>Safari</strong> 中打开下载的证书 → 前往「设置」→「通用」→「VPN与设备管理」→ 安装描述文件</div></div>
        <div class="i-step"><div class="i-num">3</div>
          <div class="i-body">「设置」→「通用」→「关于本机」→「证书信任设置」→ 开启 VoiceBridge 完全信任</div></div>
        <div class="i-step"><div class="i-num">4</div>
          <div class="i-body">💡 若提示「证书无私钥」或要求输入 PIN / 指纹，<strong>直接点确认</strong>即可</div></div>`
    } else if (isAndroid()) {
      platformNote = `
        <div class="i-step"><div class="i-num">2</div>
          <div class="i-body">下载完成 → 在通知栏或文件管理器中点击证书文件</div></div>
        <div class="i-step"><div class="i-num">3</div>
          <div class="i-body">系统弹出安装向导 → 输入 PIN / 指纹解锁 → 选择「CA 证书」→ 确认安装</div></div>
        <div class="i-step"><div class="i-num">4</div>
          <div class="i-body">💡 若提示「无私钥」，<strong>直接点确认</strong>即可</div></div>`
    } else {
      platformNote = `
        <div class="i-step"><div class="i-num">2</div>
          <div class="i-body">双击下载的 <code>VoiceBridge.crt</code> 文件，打开安装向导</div></div>
        <div class="i-step"><div class="i-num">3</div>
          <div class="i-body">选择安装到「受信任的根证书颁发机构」→ 点击确认完成安装</div></div>
        <div class="i-step"><div class="i-num">4</div>
          <div class="i-body">💡 若提示「无私钥」或输入 PIN / 指纹，<strong>直接点确认</strong>即可</div></div>`
    }

    el.innerHTML = `
      <div class="alert alert-hint">💡 证书用于 HTTPS 安全连接，手机麦克风功能必须安装。</div>
      <div class="install-steps">
        <div class="i-step"><div class="i-num">1</div>
          <div class="i-body">点击下方按钮，下载证书文件 <code>VoiceBridge.crt</code></div></div>
        ${platformNote}
      </div>
      <a href="${certUrl}" class="btn btn-primary" id="certDownloadBtn"
        onclick="onCertDownloadClick(this, event)" download="VoiceBridge.crt">
        ⬇️ 下载证书
      </a>
      <button class="check-btn" id="manualCheckBtn" onclick="manualCheckHttps()">
        🔍 检测 HTTPS 访问状态
      </button>
      <div id="certStatusBox" class="cert-tip cert-tip-loading" style="margin-top:10px; display:none">
        <span class="cert-tip-icon">⏳</span> 正在检测…
      </div>`
  }

  // ── 渲染：开始使用 ──
  function renderEnter() {
    const el = $('enterBody')

    if (!deviceName) {
      el.innerHTML = `<p style="font-size:13px;color:var(--text-hint)">请先完成设备命名。</p>`
      return
    }

    if (httpsHealthy) {
      el.innerHTML = `
        <button class="btn btn-primary" onclick="gotoHttps()">
          🔒 进入 HTTPS 安全模式
        </button>
        <button class="btn btn-gray" onclick="gotoMain()" style="margin-top:8px">
          🚀 继续使用 HTTP（功能受限）
        </button>`
    } else {
      el.innerHTML = `
        <button class="btn btn-primary" disabled onclick="gotoHttps()">
          🔒 进入 HTTPS 安全模式
        </button>
        <button class="btn btn-gray" onclick="gotoMain()" style="margin-top:8px">
          🚀 继续使用 HTTP（功能受限）
        </button>
        <p style="font-size:12px;color:var(--text-hint);margin-top:10px;text-align:center">
          请先完成证书安装，HTTPS 检测通过后上方按钮可点击
        </p>`
    }
  }

  // ============================================================
  //  手动触发证书检测
  // ============================================================
  window.manualCheckHttps = async function () {
    const btn = document.getElementById('manualCheckBtn')
    if (btn) { btn.disabled = true; btn.textContent = '⏳ 检测中…' }
    await httpsHealthCheck()
    if (btn) { btn.disabled = false; btn.textContent = '🔍 重新检测 HTTPS 访问' }
  }

  // ============================================================
  //  行动函数
  // ============================================================
  window.saveName = async function () {
    const input = document.getElementById('nameInput')
    const name  = input ? input.value.trim() : ''
    if (!name) { toast('⚠️ 请输入名称'); return }

    const btn = document.getElementById('saveBtnEl')
    if (btn) { btn.disabled = true; btn.textContent = '保存中…' }

    saveDeviceName(name)
    deviceName = name

    await Promise.all([
      postJSON(`${API_BASE}/api/setup/name`, { device_id: deviceId, name }).catch(() => null),
      postJSON(`${API_BASE}/api/device/register`, {
        device_id: deviceId,
        device_name: name,
        device_type: isMobile() ? 'mobile' : 'desktop',
        device_fingerprint: deviceFp
      }).catch(() => null)
    ])

    startHeartbeat()

    renderSteps()
    collapseCard('nameCard')
    saveCardStates()

    toast('✅ 设备名称已保存')
  }

  // 证书下载：区分成功/失败提示
  window.onCertDownloadClick = function(btn, event) {
    markCertDownloaded()
    // 延迟检测下载结果（实际体验：下载通常成功，失败很少见）
    setTimeout(() => {
      // 检查文件是否真正触发了下载（通过 download 属性）
      toast('证书下载成功，请双击安装 VoiceBridge.crt 文件', 3500)
    }, 500)
  }

  window.gotoHttps = function () {
    if (!httpsHealthy) return
    markOnboardingDone()
    window.location.href = `https://${serverIp}:${HTTPS_PORT}`
  }

  window.gotoHttp = function () {
    markOnboardingDone()
    window.location.href = `http://${serverIp}:${HTTP_PORT}`
  }

  window.gotoMain = function () {
    markOnboardingDone()
    if (IS_HTTPS) {
      window.location.href = `https://${serverIp}:${HTTPS_PORT}`
    } else {
      window.location.href = `http://${serverIp}:${HTTP_PORT}`
    }
  }

  // ============================================================
  //  启动
  // ============================================================
  init()
})()
</script>
</body>
</html>

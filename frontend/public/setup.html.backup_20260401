<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <title>Voice Bridge · 设备设置</title>
  <style>
    :root {
      --blue: #2563eb;
      --blue-light: #eff6ff;
      --blue-dark: #1d4ed8;
      --green: #16a34a;
      --green-light: #f0fdf4;
      --orange: #ea580c;
      --orange-light: #fff7ed;
      --red: #dc2626;
      --red-light: #fef2f2;
      --yellow: #ca8a04;
      --yellow-light: #fefce8;
      --gray: #6b7280;
      --gray-light: #f3f4f6;
      --border: #e5e7eb;
      --bg: #f0f4f8;
      --text: #111827;
      --card-shadow: 0 2px 12px rgba(0,0,0,.07);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 20px 16px 80px;
    }

    /* ── 顶部 Logo ── */
    .logo { text-align: center; padding: 12px 0 24px; }
    .logo h1 { font-size: 22px; font-weight: 800; color: var(--blue); }
    .logo p { font-size: 13px; color: var(--gray); margin-top: 3px; }

    /* ── 卡片 ── */
    .card {
      background: #fff;
      border-radius: 16px;
      padding: 18px 16px;
      margin-bottom: 14px;
      box-shadow: var(--card-shadow);
      border: 1px solid rgba(0,0,0,.04);
    }
    .card-title {
      font-size: 12px;
      font-weight: 700;
      color: var(--gray);
      letter-spacing: .06em;
      text-transform: uppercase;
      margin-bottom: 14px;
    }

    /* ── 信息行 ── */
    .info-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 9px 0;
      border-bottom: 1px solid var(--border);
      font-size: 14px;
    }
    .info-row:last-child { border-bottom: none; }
    .info-row .lbl { color: var(--gray); flex-shrink: 0; }
    .info-row .val { font-weight: 600; font-family: "SF Mono", monospace; font-size: 14px; }
    .info-row .val.link { color: var(--blue); cursor: pointer; }
    .info-row .val.highlight { color: var(--blue); font-weight: 700; }
    .info-row .val.dimmed { color: var(--gray); font-weight: 400; opacity: 0.6; }
    .info-row .val a { color: inherit; text-decoration: none; }
    .info-row .val a:hover { text-decoration: underline; }

    /* ── 步骤进度条 ── */
    .step-track {
      display: flex;
      align-items: center;
      margin-bottom: 20px;
    }
    .step-node {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex: 1;
      position: relative;
    }
    .step-node::before {
      content: '';
      position: absolute;
      top: 14px;
      left: 50%;
      width: 100%;
      height: 2px;
      background: var(--border);
      z-index: 0;
    }
    .step-node:last-child::before { display: none; }
    .step-node.done::before { background: var(--green); }
    .step-circle {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: var(--border);
      color: var(--gray);
      font-size: 12px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1;
      position: relative;
      transition: background .3s, color .3s;
    }
    .step-circle.active  { background: var(--blue); color: #fff; }
    .step-circle.done    { background: var(--green); color: #fff; }
    .step-label { font-size: 11px; color: var(--gray); margin-top: 5px; text-align: center; }

    /* ── 提示框 ── */
    .alert {
      padding: 11px 13px;
      border-radius: 10px;
      font-size: 13px;
      line-height: 1.6;
      margin-bottom: 12px;
    }
    .alert-blue   { background: var(--blue-light); color: #1d4ed8; border-left: 3px solid var(--blue); }
    .alert-green  { background: var(--green-light); color: #15803d; border-left: 3px solid var(--green); }
    .alert-orange { background: var(--orange-light); color: #9a3412; border-left: 3px solid var(--orange); }
    .alert-yellow { background: var(--yellow-light); color: #713f12; border-left: 3px solid var(--yellow); }
    .alert-red    { background: var(--red-light); color: #991b1b; border-left: 3px solid var(--red); }

    /* ── 按钮 ── */
    .btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      width: 100%;
      padding: 14px 16px;
      border-radius: 12px;
      font-size: 16px;
      font-weight: 600;
      text-align: center;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: transform .1s, opacity .15s;
      margin-top: 10px;
      -webkit-appearance: none;
    }
    .btn:active { transform: scale(.97); opacity: .9; }
    .btn-primary   { background: var(--blue); color: #fff; }
    .btn-secondary { background: var(--blue-light); color: var(--blue); }
    .btn-green     { background: var(--green); color: #fff; }
    .btn-gray      { background: var(--gray-light); color: var(--text); }
    .btn-danger    { background: var(--red-light); color: var(--red); }
    .btn:disabled  { opacity: .5; cursor: not-allowed; }
    .btn-small { padding: 10px 14px; font-size: 14px; }

    /* ── 安装步骤 ── */
    .install-steps { display: flex; flex-direction: column; gap: 10px; margin: 12px 0; }
    .i-step { display: flex; gap: 10px; align-items: flex-start; }
    .i-num {
      width: 22px; height: 22px;
      background: var(--blue); color: #fff;
      border-radius: 50%;
      font-size: 12px; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; margin-top: 1px;
    }
    .i-body { font-size: 13px; line-height: 1.6; }
    .i-body code { background: var(--gray-light); padding: 1px 5px; border-radius: 4px; font-size: 12px; }

    /* ── 输入框 ── */
    .input-group { margin: 12px 0 6px; }
    input[type="text"], input[type="password"] {
      width: 100%;
      padding: 12px 14px;
      border: 1.5px solid var(--border);
      border-radius: 10px;
      font-size: 16px;
      outline: none;
      color: var(--text);
      background: #fff;
      -webkit-appearance: none;
      transition: border-color .2s;
    }
    input:focus { border-color: var(--blue); }
    .input-hint { font-size: 12px; color: var(--gray); margin-top: 5px; }

    /* ── 成功态 ── */
    .device-named { text-align: center; padding: 8px 0 4px; }
    .device-named .name-big { font-size: 24px; font-weight: 800; margin-bottom: 4px; }
    .device-named .name-sub { font-size: 13px; color: var(--gray); }
    .device-id { font-size: 11px; color: var(--gray); font-family: monospace; margin-top: 4px; word-break: break-all; }

    /* ── 隐藏 ── */
    .hidden { display: none !important; }

    /* ── 加载中 ── */
    .loading {
      text-align: center;
      padding: 60px 20px;
      color: var(--gray);
      font-size: 15px;
    }
    .loading .spin {
      display: inline-block;
      animation: spin 1s linear infinite;
      font-size: 32px;
      margin-bottom: 14px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .loading .tip { font-size: 12px; margin-top: 8px; }

    /* ── Toast ── */
    .toast {
      position: fixed; bottom: 40px; left: 50%;
      transform: translateX(-50%);
      background: #111; color: #fff;
      padding: 10px 22px;
      border-radius: 99px;
      font-size: 14px;
      z-index: 9999;
      white-space: nowrap;
      transition: opacity .4s;
    }

    /* ── 按钮组 ── */
    .btn-group { display: flex; gap: 8px; margin-top: 10px; }
    .btn-group .btn { flex: 1; margin-top: 0; }

    /* ── 弹窗 ── */
    .modal-overlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.5);
      display: flex; align-items: center; justify-content: center;
      z-index: 10000;
      padding: 20px;
    }
    .modal-box {
      background: #fff;
      border-radius: 16px;
      padding: 24px 20px;
      width: 100%;
      max-width: 340px;
      text-align: center;
    }
    .modal-box h3 { font-size: 18px; margin-bottom: 12px; }
    .modal-box p { font-size: 14px; color: var(--gray); margin-bottom: 16px; line-height: 1.6; }
    .modal-box .btn-group .btn { margin-top: 0; }

    /* ── 页脚 ── */
    .footer {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      padding: 12px 16px;
      background: rgba(255,255,255,0.95);
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: center;
      gap: 16px;
      font-size: 12px;
      color: var(--gray);
    }
    .footer a { color: var(--blue); text-decoration: none; cursor: pointer; }
    .footer a:hover { text-decoration: underline; }
  </style>
</head>
<body>

<div class="logo">
  <h1>🌉 Voice Bridge</h1>
  <p>设备初始化向导</p>
</div>

<!-- 加载中 -->
<div id="loading" class="loading">
  <div class="spin">⚙️</div>
  <div id="loadingText">正在初始化设备…</div>
  <div class="tip">请稍候</div>
</div>

<!-- 主内容 -->
<div id="main" class="hidden">

  <!-- 步骤进度 -->
  <div class="card">
    <div class="step-track">
      <div class="step-node" id="step1Node">
        <div class="step-circle" id="sc1">1</div>
        <div class="step-label">命名设备</div>
      </div>
      <div class="step-node" id="step2Node">
        <div class="step-circle" id="sc2">2</div>
        <div class="step-label">安装证书</div>
      </div>
      <div class="step-node" id="step3Node">
        <div class="step-circle" id="sc3">3</div>
        <div class="step-label">开始使用</div>
      </div>
    </div>
  </div>

  <!-- 连接信息 -->
  <div class="card">
    <div class="card-title">📡 服务地址</div>
    <div class="info-row">
      <span class="lbl">HTTP 本地</span>
      <span class="val" id="httpAddr"></span>
    </div>
    <div class="info-row">
      <span class="lbl">HTTPS 局域网</span>
      <span class="val" id="httpsAddr"></span>
    </div>
  </div>

  <!-- 步骤1：设备命名 -->
  <div class="card" id="nameCard">
    <div class="card-title">✏️ 第 1 步：给设备起名</div>
    <div id="nameBody"></div>
  </div>

  <!-- 步骤2：证书安装 -->
  <div class="card" id="certCard">
    <div class="card-title">🔒 第 2 步：安装证书</div>
    <div id="certBody"></div>
  </div>

  <!-- 步骤3：开始使用 -->
  <div class="card" id="enterCard">
    <div class="card-title">🚀 第 3 步：开始使用</div>
    <div id="enterBody"></div>
  </div>

</div>

<!-- 设备确认弹窗 -->
<div id="deviceConfirmModal" class="modal-overlay hidden">
  <div class="modal-box">
    <h3>🔄 检测到已有设备</h3>
    <p id="confirmMsg">检测到您已注册过此设备，是否直接使用？</p>
    <div class="btn-group">
      <button class="btn btn-secondary" onclick="closeModal()">取消</button>
      <button class="btn btn-primary" onclick="confirmExistingDevice()">确认使用</button>
    </div>
  </div>
</div>

<!-- 设备认领弹窗 -->
<div id="deviceClaimModal" class="modal-overlay hidden">
  <div class="modal-box">
    <h3>🔑 认领设备</h3>
    <p>输入设备ID，绑定到当前浏览器</p>
    <div class="input-group">
      <input type="text" id="claimDeviceId" placeholder="请输入设备ID">
    </div>
    <div class="btn-group">
      <button class="btn btn-secondary" onclick="closeClaimModal()">取消</button>
      <button class="btn btn-primary" onclick="doClaimDevice()">确认认领</button>
    </div>
    <div style="margin-top:16px">
      <a onclick="showResetConfirm()" style="font-size:12px;color:var(--red);cursor:pointer">重置设备信息</a>
    </div>
  </div>
</div>

<!-- 重置确认弹窗 -->
<div id="resetConfirmModal" class="modal-overlay hidden">
  <div class="modal-box">
    <h3>⚠️ 确认重置</h3>
    <p>重置将清除当前浏览器的设备信息，需要重新设置。是否继续？</p>
    <div class="btn-group">
      <button class="btn btn-secondary" onclick="closeResetModal()">取消</button>
      <button class="btn btn-danger" onclick="doResetDevice()">确认重置</button>
    </div>
  </div>
</div>

<!-- 页脚 -->
<div class="footer hidden" id="footer">
  <a onclick="showClaimModal()">认领设备</a>
  <span>|</span>
  <a onclick="showResetConfirm()">重置</a>
</div>

<script>
(function () {
  'use strict';

  // ============================================================
  //  常量
  // ============================================================
  const HTTP_PORT   = 7266
  const HTTPS_PORT  = 7267
  const IS_HTTPS    = location.protocol === 'https:'
  const HOST        = location.hostname
  const PORT        = location.port
  const API_BASE    = `${location.protocol}//${HOST}:${PORT}`
  const API_TIMEOUT = 200 // 毫秒

  // localStorage keys
  const DEVICE_ID_KEY        = 'vb_device_id'
  const DEVICE_NAME_KEY      = 'vb_device_name'
  const DEVICE_FP_KEY        = 'vb_device_fingerprint'
  const ONBOARDING_KEY       = 'vb_onboarding_done'
  const CERT_TRUSTED_KEY     = 'vb_cert_trusted'

  // ============================================================
  //  状态
  // ============================================================
  let serverIp       = HOST
  let deviceId       = ''
  let deviceName     = ''
  let deviceFingerp  = ''
  let isConfigured   = false
  let certStatus     = 'unknown'  // unknown / not_trusted / trusted
  let currentStep    = 1
  let existingDevice = null       // 自动匹配到的已有设备
  let isMobileDevice = false

  // ============================================================
  //  工具函数
  // ============================================================
  const $  = id  => document.getElementById(id)
  const esc = s  => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')

  const isIOS      = () => /iphone|ipad|ipod/i.test(navigator.userAgent)
  const isAndroid  = () => /android/i.test(navigator.userAgent)
  const isMobile   = () => isIOS() || isAndroid()
  const isLocalhost = () => HOST === 'localhost' || HOST === '127.0.0.1'

  function toast(msg) {
    let t = document.querySelector('.toast')
    if (t) t.remove()
    t = document.createElement('div')
    t.className = 'toast'
    t.textContent = msg
    document.body.appendChild(t)
    setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 400) }, 2200)
  }

  function showLoading(text) {
    const el = $('loadingText')
    if (el) el.textContent = text || '正在初始化…'
  }

  // ============================================================
  //  UUID 生成
  // ============================================================
  function generateUUID() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
      const r = Math.random() * 16 | 0
      return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16)
    })
  }

  // ============================================================
  //  设备指纹生成（canvas + UA + 屏幕 + 语言 → SHA256）
  // ============================================================
  async function generateFingerprint() {
    // 检查缓存
    const cached = localStorage.getItem(DEVICE_FP_KEY)
    if (cached) return cached

    try {
      // Canvas 指纹
      const canvas = document.createElement('canvas')
      const ctx = canvas.getContext('2d')
      canvas.width = 200
      canvas.height = 50
      ctx.textBaseline = 'top'
      ctx.font = "14px 'Arial'"
      ctx.fillStyle = '#f60'
      ctx.fillRect(125, 1, 62, 20)
      ctx.fillStyle = '#069'
      ctx.fillText('VoiceBridge 🌉', 2, 15)
      ctx.fillStyle = 'rgba(102,204,0,0.7)'
      ctx.fillText('Device FP', 4, 17)
      const canvasData = canvas.toDataURL()

      // 组合信息
      const fpData = [
        canvasData,
        navigator.userAgent,
        screen.width + 'x' + screen.height,
        screen.colorDepth,
        navigator.language,
        new Date().getTimezoneOffset(),
        navigator.hardwareConcurrency || '',
        navigator.platform || ''
      ].join('|')

      // SHA256 哈希
      const msgBuffer = new TextEncoder().encode(fpData)
      const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer)
      const hashArray = Array.from(new Uint8Array(hashBuffer))
      const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('')

      // 缓存
      localStorage.setItem(DEVICE_FP_KEY, hashHex)
      return hashHex
    } catch (e) {
      console.warn('Fingerprint generation failed:', e)
      // 降级：使用随机 ID
      const fallback = generateUUID()
      localStorage.setItem(DEVICE_FP_KEY, fallback)
      return fallback
    }
  }

  // ============================================================
  //  设备 ID 管理
  // ============================================================
  function getOrCreateDeviceId() {
    let id = localStorage.getItem(DEVICE_ID_KEY)
    if (!id) {
      id = generateUUID()
      localStorage.setItem(DEVICE_ID_KEY, id)
    }
    return id
  }

  function getDeviceName() {
    return localStorage.getItem(DEVICE_NAME_KEY) || ''
  }

  function saveDeviceName(name) {
    localStorage.setItem(DEVICE_NAME_KEY, name)
  }

  function markOnboardingDone() {
    localStorage.setItem(ONBOARDING_KEY, '1')
  }

  function markCertTrusted() {
    localStorage.setItem(CERT_TRUSTED_KEY, '1')
  }

  function isCertTrusted() {
    return localStorage.getItem(CERT_TRUSTED_KEY) === '1'
  }

  function resetDeviceInfo() {
    localStorage.removeItem(DEVICE_ID_KEY)
    localStorage.removeItem(DEVICE_NAME_KEY)
    localStorage.removeItem(ONBOARDING_KEY)
    // 保留指纹，以便重新匹配
  }

  // ============================================================
  //  API 调用
  // ============================================================
  async function fetchJSON(url, options = {}) {
    const controller = new AbortController()
    const timeout = setTimeout(() => controller.abort(), options.timeout || API_TIMEOUT)
    try {
      const res = await fetch(url, { ...options, signal: controller.signal })
      clearTimeout(timeout)
      if (!res.ok && options.expectBinary) return null
      const ct = res.headers.get('content-type') || ''
      if (ct.includes('application/json')) return res.json()
      if (options.expectBinary) return res.blob()
      return res.text()
    } catch (e) {
      clearTimeout(timeout)
      return null
    }
  }

  async function postJSON(url, body) {
    return fetchJSON(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
      timeout: 500
    })
  }

  // ============================================================
  //  初始化（异步非阻塞）
  // ============================================================
  async function init() {
    showLoading('正在生成设备标识…')
    
    // 1. 生成设备指纹（异步）
    deviceFingerp = await generateFingerprint()
    deviceId = getOrCreateDeviceId()
    deviceName = getDeviceName()
    isMobileDevice = isMobile()

    showLoading('正在连接服务器…')

    // 2. 后台并行获取服务器信息 + 检查设备配置状态
    const [serverInfo, checkResult] = await Promise.all([
      fetchJSON(`${API_BASE}/api/setup/info`).catch(() => null),
      fetchJSON(`${API_BASE}/api/device/check?device_id=${encodeURIComponent(deviceId)}`).catch(() => null)
    ])

    if (serverInfo) {
      serverIp = serverInfo.server_ip || serverIp
    }

    if (checkResult && checkResult.ok) {
      isConfigured = checkResult.is_configured
      if (checkResult.device_name) {
        deviceName = checkResult.device_name
        saveDeviceName(deviceName)
      }
    }

    showLoading('正在识别设备…')

    // 3. 自动匹配检查（如果本地没有 device_id）
    const localHasId = !!localStorage.getItem(DEVICE_ID_KEY)
    
    if (!localHasId && deviceFingerp) {
      // 尝试通过指纹匹配已有设备
      const matchResult = await postJSON(`${API_BASE}/api/device/auto-match`, {
        device_fingerprint: deviceFingerp,
        current_ip: HOST
      })

      if (matchResult && matchResult.ok && matchResult.is_found) {
        existingDevice = {
          device_id: matchResult.device_id,
          device_name: matchResult.device_name,
          device_type: matchResult.device_type
        }
      }
    }

    showLoading('正在加载页面…')

    // 4. 显示页面
    $('loading').classList.add('hidden')
    $('main').classList.remove('hidden')
    $('footer').classList.remove('hidden')

    // 5. 渲染
    renderAll()

    // 6. 自动跳转：已配置 + HTTPS 模式
    if (isConfigured && IS_HTTPS && deviceName) {
      setTimeout(() => {
        toast('检测到已完成设置，正在跳转…')
        setTimeout(() => gotoMain(), 800)
      }, 500)
      return
    }

    // 7. 显示设备确认弹窗（如果匹配到已有设备）
    if (existingDevice) {
      showDeviceConfirmModal()
    }
  }

  // ============================================================
  //  渲染
  // ============================================================
  function renderAll() {
    renderAddress()
    renderSteps()
    renderName()
    renderCert()
    renderEnter()
  }

  function renderAddress() {
    const httpUrl  = `http://127.0.0.1:${HTTP_PORT}`
    const httpsUrl = `https://${serverIp}:${HTTPS_PORT}`

    const httpEl = $('httpAddr')
    const httpsEl = $('httpsAddr')

    // HTTP 地址
    const httpLink = `<a href="#" onclick="gotoHttp();return false;">${httpUrl}</a>`
    httpEl.innerHTML = IS_HTTPS 
      ? `<span class="dimmed">${httpLink}</span>`
      : `<span class="highlight">${httpLink}</span>`

    // HTTPS 地址
    const httpsLink = `<a href="#" onclick="gotoHttps();return false;">${httpsUrl}</a>`
    httpsEl.innerHTML = IS_HTTPS 
      ? `<span class="highlight">${httpsLink}</span>`
      : `<span class="dimmed">${httpsLink}</span>`
  }

  function renderSteps() {
    // 确定当前步骤
    if (!deviceName) {
      currentStep = 1
    } else if (!certStatus || certStatus === 'not_trusted') {
      currentStep = 2
    } else {
      currentStep = 3
    }

    const steps = [
      { el: $('sc1'), node: $('step1Node') },
      { el: $('sc2'), node: $('step2Node') },
      { el: $('sc3'), node: $('step3Node') }
    ]

    steps.forEach((s, i) => {
      s.el.className = 'step-circle'
      s.node.classList.remove('done')

      if (i + 1 < currentStep) {
        s.el.classList.add('done')
        s.el.textContent = '✓'
        s.node.classList.add('done')
      } else if (i + 1 === currentStep) {
        s.el.classList.add('active')
      } else {
        s.el.textContent = i + 1
      }
    })
  }

  function renderName() {
    const el = $('nameBody')

    if (deviceName) {
      el.innerHTML = `
        <div class="device-named">
          <div class="name-big">🏷️ ${esc(deviceName)}</div>
          <div class="name-sub">当前设备名称</div>
          <div class="device-id">ID: ${esc(deviceId)}</div>
        </div>
        <div class="input-group">
          <input type="text" id="nameInput" placeholder="修改名称…" maxlength="32" value="${esc(deviceName)}">
          <p class="input-hint">最多 32 个字符，支持中文、英文、emoji</p>
        </div>
        <button class="btn btn-secondary" onclick="saveName()">💾 保存修改</button>`
    } else {
      el.innerHTML = `
        <div class="alert alert-blue">给你的设备起个名字，方便识别。</div>
        <div class="input-group">
          <input type="text" id="nameInput" placeholder="例如：小明的手机、iPad Pro…" maxlength="32">
          <p class="input-hint">最多 32 个字符，支持中文、英文、emoji</p>
        </div>
        <button class="btn btn-primary" onclick="saveName()" id="saveBtnEl">✅ 确认命名</button>`
      setTimeout(() => document.getElementById('nameInput')?.focus(), 100)
    }
  }

  function renderCert() {
    const el = $('certBody')
    const certUrl = `${API_BASE}/api/cert/download`

    if (IS_HTTPS) {
      // HTTPS 模式
      if (certStatus === 'trusted' || isCertTrusted()) {
        certStatus = 'trusted'
        el.innerHTML = `
          <div class="alert alert-green">✅ 证书已信任，HTTPS 安全模式已就绪</div>
          <div style="font-size:13px;color:var(--gray)">您可以正常使用全部功能。</div>`
      } else {
        certStatus = 'not_trusted'
        el.innerHTML = `
          <div class="alert alert-orange">⚠️ 当前 HTTPS 连接已建立，但证书尚未完全信任</div>
          <div class="install-steps">
            <div class="i-step"><div class="i-num">1</div>
              <div class="i-body">打开系统设置 → 通用 → 关于本机 → 证书信任设置</div></div>
            <div class="i-step"><div class="i-num">2</div>
              <div class="i-body">找到 VoiceBridge 证书，开启完全信任</div></div>
          </div>
          <div style="font-size:12px;color:var(--gray);margin-top:8px">信任完成后刷新页面即可。</div>
          <button class="btn btn-secondary" onclick="markTrustedAndRerender()">✅ 我已完成信任，刷新页面</button>`
      }
    } else {
      // HTTP 模式
      certStatus = 'not_trusted'
      
      if (isIOS()) {
        el.innerHTML = `
          <div class="alert alert-orange">⚠️ 需要安装证书才能使用 HTTPS 安全模式</div>
          <div class="install-steps">
            <div class="i-step"><div class="i-num">1</div>
              <div class="i-body">点击下方按钮，用 <strong>Safari</strong> 打开下载证书</div></div>
            <div class="i-step"><div class="i-num">2</div>
              <div class="i-body">打开 <code>设置</code> → <code>通用</code> → <code>VPN与设备管理</code> → 安装</div></div>
            <div class="i-step"><div class="i-num">3</div>
              <div class="i-body">打开 <code>设置</code> → <code>通用</code> → <code>关于本机</code> → <code>证书信任设置</code> → 开启完全信任</div></div>
          </div>
          <a href="${certUrl}" class="btn btn-primary">⬇️ 下载证书（Safari）</a>`
      } else if (isAndroid()) {
        el.innerHTML = `
          <div class="alert alert-orange">⚠️ 需要安装证书才能使用 HTTPS 安全模式</div>
          <div class="install-steps">
            <div class="i-step"><div class="i-num">1</div>
              <div class="i-body">点击下方按钮下载证书文件 <code>VoiceBridge.crt</code></div></div>
            <div class="i-step"><div class="i-num">2</div>
              <div class="i-body">下载完成后，点击浏览器下载通知里的证书文件</div></div>
            <div class="i-step"><div class="i-num">3</div>
              <div class="i-body">系统弹出安装向导，输入 PIN 码，确认安装即可</div></div>
          </div>
          <a href="${certUrl}" class="btn btn-primary" id="dlCertBtn">⬇️ 下载证书</a>`
      } else {
        // 电脑
        el.innerHTML = `
          <div class="alert alert-blue">
            您在<strong>电脑</strong>上访问。<br>
            直接访问 HTTPS 地址，浏览器会提示风险 → 点击<strong>「高级」→「继续访问」</strong>即可。
          </div>
          <button class="btn btn-primary" onclick="gotoHttps()">🔒 前往 HTTPS 模式</button>`
      }
    }
  }

  function renderEnter() {
    const el = $('enterBody')
    const httpsUrl = `https://${serverIp}:${HTTPS_PORT}`
    const httpUrl  = `http://${HOST}:${HTTP_PORT}`

    if (!deviceName) {
      el.innerHTML = `<p style="font-size:13px;color:var(--gray)">请先完成设备命名。</p>`
      return
    }

    // 未安装证书时 HTTPS 按钮禁用
    const certReady = IS_HTTPS ? (certStatus === 'trusted' || isCertTrusted()) : true

    if (IS_HTTPS) {
      el.innerHTML = `
        <div class="alert alert-green">
          🎉 <strong>设置完成！</strong>您的设备已就绪。
        </div>
        <button class="btn btn-green" onclick="gotoMain()">🚀 进入 Voice Bridge</button>
        ${isLocalhost() ? `
        <button class="btn btn-secondary" onclick="gotoHttp()" style="margin-top:8px">💻 返回 HTTP 本地</button>` : ''}`
    } else {
      el.innerHTML = `
        <div class="alert alert-yellow">选择进入方式：</div>
        <button class="btn btn-primary" onclick="gotoHttps()" ${certReady ? '' : 'disabled title="请先完成证书安装"'}>
          🔒 进入 HTTPS 安全模式
        </button>
        <button class="btn btn-gray" onclick="gotoMain()" style="margin-top:8px">
          🚀 继续使用 HTTP（功能受限）
        </button>`
      if (!certReady) {
        el.innerHTML += `<p style="font-size:12px;color:var(--orange);margin-top:8px">⚠️ 请先完成证书安装</p>`
      }
    }
  }

  // ============================================================
  //  弹窗控制
  // ============================================================
  function showDeviceConfirmModal() {
    if (!existingDevice) return
    const msg = `检测到您已注册过此设备：\n设备名：${existingDevice.device_name}\n设备ID：${existingDevice.device_id}\n\n是否直接使用该设备信息？`
    $('confirmMsg').textContent = msg
    $('deviceConfirmModal').classList.remove('hidden')
  }

  function closeModal() {
    $('deviceConfirmModal').classList.add('hidden')
  }

  async function confirmExistingDevice() {
    if (!existingDevice) return
    closeModal()

    // 绑定指纹到已有设备
    await postJSON(`${API_BASE}/api/device/bind-fingerprint`, {
      device_fingerprint: deviceFingerp,
      current_ip: existingDevice.device_id  // 复用字段传 device_id
    })

    // 使用已有设备信息
    deviceId = existingDevice.device_id
    deviceName = existingDevice.device_name
    localStorage.setItem(DEVICE_ID_KEY, deviceId)
    saveDeviceName(deviceName)

    toast('✅ 已使用已有设备信息')
    renderAll()
  }

  function showClaimModal() {
    $('deviceClaimModal').classList.remove('hidden')
    $('claimDeviceId').value = ''
    $('claimDeviceId').focus()
  }

  function closeClaimModal() {
    $('deviceClaimModal').classList.add('hidden')
  }

  async function doClaimDevice() {
    const deviceIdInput = $('claimDeviceId').value.trim()
    if (!deviceIdInput) {
      toast('⚠️ 请输入设备ID')
      return
    }

    const result = await postJSON(`${API_BASE}/api/device/register`, {
      device_id: deviceIdInput,
      device_name: '',
      device_type: isMobileDevice ? 'mobile' : 'desktop',
      device_fingerprint: deviceFingerp
    })

    if (result && result.ok) {
      deviceId = deviceIdInput
      localStorage.setItem(DEVICE_ID_KEY, deviceId)
      closeClaimModal()
      toast('✅ 设备已认领')
      renderAll()
    } else {
      toast('❌ 认领失败')
    }
  }

  function showResetConfirm() {
    $('resetConfirmModal').classList.remove('hidden')
  }

  function closeResetModal() {
    $('resetConfirmModal').classList.add('hidden')
  }

  async function doResetDevice() {
    closeResetModal()
    closeModal()
    closeClaimModal()
    resetDeviceInfo()
    deviceId = getOrCreateDeviceId()
    deviceName = ''
    toast('🔄 设备已重置，请重新设置')
    renderAll()
  }

  function markTrustedAndRerender() {
    markCertTrusted()
    certStatus = 'trusted'
    renderAll()
    toast('✅ 证书已标记为信任')
  }

  // ============================================================
  //  行动函数
  // ============================================================
  window.saveName = async function() {
    const input = document.getElementById('nameInput')
    const name = input ? input.value.trim() : ''
    if (!name) { toast('⚠️ 请输入名称'); return; }
    if (name.length > 32) { toast('⚠️ 名称最多32字符'); return; }

    const btn = document.getElementById('saveBtnEl')
    if (btn) { btn.disabled = true; btn.textContent = '保存中…' }

    saveDeviceName(name)
    deviceName = name

    // 同步到服务器
    const data = await postJSON(`${API_BASE}/api/setup/name`, {
      device_id: deviceId,
      name: name
    })

    // 同时注册设备（如果还没注册）
    await postJSON(`${API_BASE}/api/device/register`, {
      device_id: deviceId,
      device_name: name,
      device_type: isMobileDevice ? 'mobile' : 'desktop',
      device_fingerprint: deviceFingerp
    })

    renderAll()
    toast('✅ 设备名称已保存！')
  }

  window.gotoHttps = function() {
    markOnboardingDone()
    const httpsFullUrl = `https://${serverIp}:${HTTPS_PORT}`
    window.location.href = httpsFullUrl + '/setup'
  }

  window.gotoHttp = function() {
    markOnboardingDone()
    window.location.href = `http://127.0.0.1:${HTTP_PORT}`
  }

  window.gotoMain = function() {
    markOnboardingDone()
    if (IS_HTTPS) {
      window.location.href = `https://${serverIp}:${HTTPS_PORT}`
    } else {
      window.location.href = `http://127.0.0.1:${HTTP_PORT}`
    }
  }

  window.closeModal = closeModal
  window.confirmExistingDevice = confirmExistingDevice
  window.showClaimModal = showClaimModal
  window.closeClaimModal = closeClaimModal
  window.doClaimDevice = doClaimDevice
  window.showResetConfirm = showResetConfirm
  window.closeResetModal = closeResetModal
  window.doResetDevice = doResetDevice
  window.markTrustedAndRerender = markTrustedAndRerender

  // ============================================================
  //  启动
  // ============================================================
  init()
})()
</script>
</body>
</html>

# Voice Bridge 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== HTTPS 证书（可选） ====================
# 如果设置，将优先使用指定的证书路径
# 不设置则使用 backend/certs/ 目录下的默认证书
# SSL_CERT_FILE=/path/to/server.crt
# SSL_KEY_FILE=/path/to/server.key

# ==================== 服务器配置 ====================
# host=0.0.0.0
# port=7266
# https_port=7267

# ==================== 日志级别 ====================
# log_level=INFO
